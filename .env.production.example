# Valores privados; este archivo sólo documenta los nombres.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=gastos.example.com
DJANGO_BEHIND_PROXY=True
DJANGO_HSTS_SECONDS=3600
# PostgreSQL local: no publicar 5432 en Internet.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@127.0.0.1:5432/misgastos_django
# Si la base es remota, usar CA y verificar certificado y nombre de host:
# DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/BASE?sslmode=verify-full&sslrootcert=/ruta/ca.pem
